# ── Supabase ──────────────────────────────────────────────────────────────────
# Project Settings → API
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=your-publishable-or-anon-key
DATABASE_URL=postgresql://postgres:[PASSWORD]@[HOST]:6543/postgres?pgbouncer=true
DIRECT_URL=postgresql://postgres:[PASSWORD]@[HOST]:5432/postgres

# ── Meta / Instagram app ─────────────────────────────────────────────────────
META_APP_ID=your-app-id
META_APP_SECRET=your-app-secret
# Optional: needed only when using a Facebook Login for Business configuration
META_CONFIG_ID=
META_API_VERSION=v21.0

# ── Required security secrets ────────────────────────────────────────────────
# 32-byte hex key used to encrypt stored access tokens (AES-256-GCM).
# Generate with: openssl rand -hex 32
TOKEN_VAULT_SECRET=your-32-byte-hex-key
# Verify token chosen by you and entered in the Meta app dashboard.
META_VERIFY_TOKEN=a-long-random-string
# Protects /api/cron/refresh-tokens. Vercel sends it automatically as a bearer token.
CRON_SECRET=a-long-random-string
# Optional separate signing key for OAuth state. Falls back to TOKEN_VAULT_SECRET.
OAUTH_STATE_SECRET=
# Optional: key used by older installs. Only needed for decrypting legacy tokens.
TOKEN_VAULT_LEGACY_SECRET=

# ── Admin capacity alerts (optional but recommended) ────────────────────────
# Comma-separated admin email addresses that receive architecture/capacity notices.
ADMIN_ALERT_EMAILS=
# Resend API key used to send the alerts. Without it alerts are stored in-app only.
RESEND_API_KEY=
# Verified sender address, e.g. "dmplease Alerts <alerts@yourdomain.com>"
ALERT_FROM_EMAIL=

# ── Public URL ───────────────────────────────────────────────────────────────
NEXT_PUBLIC_SITE_URL=https://your-domain.example
APP_URL=https://your-domain.example

# ── Development only ─────────────────────────────────────────────────────────
# Optional local tunnel origin used when building OAuth redirect URLs.
TUNNEL_URL=
