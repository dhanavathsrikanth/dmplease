# ── Supabase ──────────────────────────────────────────────────────────────────
# Project Settings → API
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=your-publishable-or-anon-key
DATABASE_URL=postgresql://postgres:[PASSWORD]@[HOST]:6543/postgres?pgbouncer=true
DIRECT_URL=postgresql://postgres:[PASSWORD]@[HOST]:5432/postgres

# ── Meta / Instagram app ─────────────────────────────────────────────────────
META_APP_ID=your-app-id
META_APP_SECRET=your-app-secret
# Optional: needed only when using a Facebook Login for Business configuration
META_CONFIG_ID=
META_API_VERSION=v21.0

# ── Required security secrets ────────────────────────────────────────────────
# 32-byte hex key used to encrypt stored access tokens (AES-256-GCM).
# Generate with: openssl rand -hex 32
TOKEN_VAULT_SECRET=your-32-byte-hex-key
# Verify token chosen by you and entered in the Meta app dashboard.
META_VERIFY_TOKEN=a-long-random-string
# Protects /api/cron/refresh-tokens. Vercel sends it automatically as a bearer token.
CRON_SECRET=a-long-random-string
# Protects privileged admin actions (deliver-guide, webhook-replay, dlq,
# sync-profile, followup-schedule). Must be a different value from CRON_SECRET
# so a leaked cron token cannot send DMs or replay webhooks. Required in
# production; local development falls back to CRON_SECRET.
ADMIN_API_SECRET=
# Signing key for OAuth state. Required in production: it must be a dedicated
# value, never TOKEN_VAULT_SECRET. Local development and tests fall back to
# TOKEN_VAULT_SECRET, then a public dev-only constant.
OAUTH_STATE_SECRET=
# Optional separate signing key for password-recovery grants. Falls back to
# OAUTH_STATE_SECRET. Rotating it invalidates any recovery link that is still
# open.
RECOVERY_GRANT_SECRET=
# Key used by older installs. Only needed for decrypting legacy tokens; there is
# no hardcoded fallback, so set this before rotating TOKEN_VAULT_SECRET.
TOKEN_VAULT_LEGACY_SECRET=

# ── Auth hardening ───────────────────────────────────────────────────────────
# Cloudflare Turnstile site key (public). Enable CAPTCHA in Supabase Auth with
# the matching secret, then set this so sign-up/login/reset render the widget.
# Leave empty to disable the widget (local development).
NEXT_PUBLIC_TURNSTILE_SITE_KEY=

# ── PostHog product analytics (client + server) ─────────────────────────────
NEXT_PUBLIC_POSTHOG_PROJECT_TOKEN=
NEXT_PUBLIC_POSTHOG_HOST=https://eu.i.posthog.com

# ── PostHog source-map uploads (production builds) ──────────────────────────
POSTHOG_API_KEY=your-personal-api-key
POSTHOG_PROJECT_ID=your-project-id
POSTHOG_HOST=https://your-region.posthog.com

# ── Upstash: shared rate limiting + durable webhook queue ───────────────────
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
QSTASH_TOKEN=
QSTASH_CURRENT_SIGNING_KEY=
QSTASH_NEXT_SIGNING_KEY=
QSTASH_WORKER_URL=https://your-domain.example/api/workers/qstash
# Never set QSTASH_DEV in a deployment. Worker verification pins devMode: false,
# so the package's public development signing keys are always rejected, but
# leaving the variable unset keeps the intent explicit in every environment.

# ── Cloudflare R2 — rich DM attachments (audio, PDF, image, video) ──────────
# Create an R2 bucket and an S3 API token with Object Read & Write.
# The public CDN domain must be a custom domain or r2.dev enabled for the bucket.
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=
R2_PUBLIC_CDN_URL=https://cdn.your-domain.example

# ── Admin capacity alerts (optional but recommended) ────────────────────────
# Comma-separated admin email addresses that receive architecture/capacity notices.
ADMIN_ALERT_EMAILS=
# Resend API key used to send the alerts. Without it alerts are stored in-app only.
RESEND_API_KEY=
# Verified sender address, e.g. "dmplease Alerts <alerts@yourdomain.com>"
ALERT_FROM_EMAIL=

# ── Public URL ───────────────────────────────────────────────────────────────
NEXT_PUBLIC_SITE_URL=https://your-domain.example
APP_URL=https://your-domain.example
# Optional short domain used for smart tracked links (e.g. https://dmpl.co).
# Without it, the app origin + /go is used.
SHORT_LINK_DOMAIN=

# ── Development only ─────────────────────────────────────────────────────────
# Optional local tunnel origin used when building OAuth redirect URLs.
TUNNEL_URL=
