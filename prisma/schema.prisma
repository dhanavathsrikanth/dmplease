generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model Profile {
  id                  String   @id @db.Uuid
  email               String?
  fullName            String?  @map("full_name")
  avatarUrl           String?  @map("avatar_url")
  avatarGradient      String?  @map("avatar_gradient")
  instagramHandle     String?  @map("instagram_handle")
  niche               String?  @map("niche")
  onboardingCompleted Boolean  @default(false) @map("onboarding_completed")
  heardFrom           String?  @map("heard_from")
  switchingFrom       String?  @map("switching_from")
  primaryGoal         String?  @map("primary_goal")
  createdAt           DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt           DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  ownedWorkspaces  Workspace[]       @relation("WorkspaceOwner")
  workspaceMembers WorkspaceMember[]

  @@map("profiles")
}

model Workspace {
  id        String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name      String
  ownerId   String   @map("owner_id") @db.Uuid
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  owner             Profile            @relation("WorkspaceOwner", fields: [ownerId], references: [id], onDelete: Cascade)
  members           WorkspaceMember[]
  automations       Automation[]
  instagramAccounts InstagramAccount[]
  dmLogs            DmLog[]
  contacts          Contact[]
  conversations     Conversation[]
  messages          Message[] @relation("WorkspaceMessages")
  dmRules           DmRule[]
  commentEvents    CommentEvent[]
  pendingDms        PendingDm[]
  linkClicks        LinkClick[]
  safetyEvents      SafetyEvent[]
  insightSnapshots  InsightSnapshot[]

  @@map("workspaces")
}

model WorkspaceMember {
  id          String        @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  workspaceId String        @map("workspace_id") @db.Uuid
  userId      String        @map("user_id") @db.Uuid
  role        WorkspaceRole @default(MEMBER)
  createdAt   DateTime      @default(now()) @map("created_at") @db.Timestamptz(6)

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  user      Profile   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([workspaceId, userId], name: "uq_workspace_member")
  @@map("workspace_members")
}

model Automation {
  id                  String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  workspaceId         String   @map("workspace_id") @db.Uuid
  name                String
  goal                String?
  postScope           String?  @default("ANY_POST") @map("post_scope")
  postId              String?  @map("post_id")
  postThumbnailUrl    String?  @map("post_thumbnail_url")
  postCaption         String?  @map("post_caption")
  triggerKeywords     String[] @default([]) @map("trigger_keywords")
  dmMessage           String   @map("dm_message")
  buttonText          String?  @map("button_text")
  buttonUrl           String?  @map("button_url")
  publicReplyEnabled  Boolean  @default(false) @map("public_reply_enabled")
  publicReplyMessages String[] @default([]) @map("public_reply_messages")
  followGateEnabled   Boolean  @default(false) @map("follow_gate_enabled")
  dmVariants          String[] @default([]) @map("dm_variants")
  collectField        String?  @map("collect_field")
  openingMessage      String?  @map("opening_message")
  hourlyCap           Int      @default(0) @map("hourly_cap")
  active              Boolean  @default(true)
  createdAt           DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt           DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  dmLogs    DmLog[]

  @@map("automations")
}

model InstagramAccount {
  id                   String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  workspaceId          String    @map("workspace_id") @db.Uuid
  instagramId          String    @unique @map("instagram_id")
  username             String
  name                 String?
  accessToken          String?   @map("access_token")
  tokenExpiresAt       DateTime? @map("token_expires_at") @db.Timestamptz(6)
  webhookSubscribed    Boolean   @default(false) @map("webhook_subscribed")
  fallbackReplyEnabled Boolean   @default(false) @map("fallback_reply_enabled")
  fallbackReplyMessage String?   @map("fallback_reply_message")
  connectedAt          DateTime  @default(now()) @map("connected_at") @db.Timestamptz(6)
  updatedAt            DateTime  @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  dmLogs    DmLog[]

  @@map("instagram_accounts")
}

model DmLog {
  id                 String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  workspaceId        String   @map("workspace_id") @db.Uuid
  instagramAccountId String?  @map("instagram_account_id") @db.Uuid
  automationId       String?  @map("automation_id") @db.Uuid
  recipientId        String   @map("recipient_id")
  recipientUsername  String?  @map("recipient_username")
  triggerKeyword     String?  @map("trigger_keyword")
  dmMessage          String?  @map("dm_message")
  status             String   @default("SENT")
  sentAt             DateTime @default(now()) @map("sent_at") @db.Timestamptz(6)

  workspace        Workspace         @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  instagramAccount InstagramAccount? @relation(fields: [instagramAccountId], references: [id], onDelete: SetNull)
  automation       Automation?       @relation(fields: [automationId], references: [id], onDelete: SetNull)

  @@map("dm_logs")
}

model Contact {
  id               String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  workspaceId      String   @map("workspace_id") @db.Uuid
  instagramId      String   @map("instagram_id")
  username         String?
  displayName      String?  @map("display_name")
  email            String?
  phone            String?
  properties       Json     @default("{}")
  tags             String[] @default([])
  source           String?
  optedInAt        DateTime? @map("opted_in_at") @db.Timestamptz(6)
  followVerifiedAt DateTime? @map("follow_verified_at") @db.Timestamptz(6)
  createdAt        DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt        DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  workspace     Workspace      @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  conversations Conversation[]

  @@unique([workspaceId, instagramId])
  @@map("contacts")
}

model Conversation {
  id                  String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  workspaceId         String    @map("workspace_id") @db.Uuid
  instagramAccountId  String?   @map("instagram_account_id") @db.Uuid
  contactId           String    @map("contact_id") @db.Uuid
  status              String    @default("open")
  isBotActive         Boolean   @default(true) @map("is_bot_active")
  lastMessageAt       DateTime  @default(now()) @map("last_message_at") @db.Timestamptz(6)

  workspace     Workspace    @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  contact       Contact      @relation(fields: [contactId], references: [id], onDelete: Cascade)
  messages      Message[]

  @@unique([contactId, instagramAccountId])
  @@map("conversations")
}

model Message {
  id             String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  workspaceId    String   @map("workspace_id") @db.Uuid
  conversationId String   @map("conversation_id") @db.Uuid
  externalId     String?  @map("external_id")
  direction      String
  senderType     String   @default("bot") @map("sender_type")
  contentType    String   @default("text") @map("content_type")
  content        Json
  deliveryStatus String?  @map("delivery_status")
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  conversation Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  workspace    Workspace    @relation("WorkspaceMessages", fields: [workspaceId], references: [id], onDelete: Cascade)

  @@unique([conversationId, externalId])
  @@map("messages")
}

model DmRule {
  id            String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  workspaceId   String   @map("workspace_id") @db.Uuid
  name          String
  triggerType   String   @map("trigger_type")
  keywords      String[] @default([])
  message       String
  variants      String[] @default([])
  buttonText    String?  @map("button_text")
  buttonUrl     String?  @map("button_url")
  collectField  String?  @map("collect_field")
  oncePerDays   Int      @default(45) @map("once_per_days")
  priority      Int      @default(0)
  active        Boolean  @default(true)
  createdAt     DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt     DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@map("dm_rules")
}

model CommentEvent {
  id                  String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  workspaceId         String   @map("workspace_id") @db.Uuid
  instagramAccountId  String?  @map("instagram_account_id") @db.Uuid
  externalId          String   @map("external_id")
  mediaId             String?  @map("media_id")
  commenterId         String   @map("commenter_id")
  commenterUsername   String?  @map("commenter_username")
  text                String?
  receivedAt          DateTime @default(now()) @map("received_at") @db.Timestamptz(6)

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@unique([workspaceId, externalId])
  @@map("comment_events")
}

model PendingDm {
  id                  String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  workspaceId         String   @map("workspace_id") @db.Uuid
  kind                String   @default("optin")
  automationId        String?  @map("automation_id") @db.Uuid
  ruleId              String?  @map("rule_id") @db.Uuid
  instagramAccountId  String?  @map("instagram_account_id") @db.Uuid
  recipientId         String   @map("recipient_id")
  commentId           String?  @map("comment_id")
  message             String?
  buttonText          String?  @map("button_text")
  buttonUrl           String?  @map("button_url")
  collectField        String?  @map("collect_field")
  createdAt           DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  expiresAt           DateTime @default(now()) @map("expires_at") @db.Timestamptz(6)

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@map("pending_dms")
}

model LinkClick {
  id           String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  workspaceId  String   @map("workspace_id") @db.Uuid
  automationId String?  @map("automation_id") @db.Uuid
  contactId    String?  @map("contact_id") @db.Uuid
  token        String
  referrer     String?
  createdAt    DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@map("link_clicks")
}

model SafetyEvent {
  id                  String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  workspaceId         String   @map("workspace_id") @db.Uuid
  instagramAccountId  String?  @map("instagram_account_id") @db.Uuid
  recipientId         String?  @map("recipient_id")
  kind                String   @default("dm")
  createdAt           DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@map("safety_events")
}

model InsightSnapshot {
  id                  String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  workspaceId         String   @map("workspace_id") @db.Uuid
  instagramAccountId  String   @map("instagram_account_id") @db.Uuid
  day                 DateTime @db.Date
  metric              String
  value               BigInt   @default(0)
  recordedAt          DateTime @default(now()) @map("recorded_at") @db.Timestamptz(6)

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@unique([instagramAccountId, day, metric])
  @@map("insight_snapshots")
}

/// Durable record of every verified Meta webhook and its processing outcome.
/// No workspace relation: this table is written by the service-role path only.
model WebhookEvent {
  id                 String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  object             String
  status             String    @default("PENDING")
  instagramAccountId String?   @map("instagram_account_id")
  payload            Json
  error              String?
  durationMs         Int?      @map("duration_ms")
  receivedAt         DateTime  @default(now()) @map("received_at") @db.Timestamptz(6)
  startedAt          DateTime? @map("started_at") @db.Timestamptz(6)
  completedAt        DateTime? @map("completed_at") @db.Timestamptz(6)

  @@index([status, receivedAt])
  @@map("webhook_events")
}

enum WorkspaceRole {
  OWNER
  ADMIN
  MEMBER
}
